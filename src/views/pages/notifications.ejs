<div class="page-heading">
  <div>
    <p class="eyebrow">Tetap terhubung</p>
    <h1>Notifikasi</h1>
    <p class="page-subtitle">Pengingat dan pemberitahuan penting tersimpan di sini.</p>
  </div>
  <button class="btn btn-ghost" type="button" data-mark-all-read>
    <svg class="icon"><use href="#icon-check"></use></svg>
    Tandai semua dibaca
  </button>
</div>

<div class="panel">
  <div class="notification-toolbar">
    <label class="checkbox-row">
      <input type="checkbox" data-unread-only>
      <span>Hanya yang belum dibaca</span>
    </label>
    <span class="muted" data-unread-summary></span>
  </div>
  <div class="notification-list" data-notification-list>
    <div class="skeleton skeleton-row"></div>
    <div class="skeleton skeleton-row"></div>
  </div>
  <nav class="pagination" data-notification-pagination hidden aria-label="Halaman notifikasi"></nav>
</div>
