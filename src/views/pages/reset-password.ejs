<div class="auth-card">
  <p class="eyebrow">Keamanan akun</p>
  <h2>Atur ulang password</h2>
  <p class="auth-lead">Buat password baru untuk akun Anda. Tautan ini hanya dapat digunakan sekali.</p>

  <% if (!token) { %>
    <div class="notice notice-error">
      <svg class="icon"><use href="#icon-alert"></use></svg>
      <span>Tautan reset tidak lengkap. Silakan minta tautan baru.</span>
    </div>
    <a class="btn btn-primary btn-block" href="/forgot-password">Minta tautan baru</a>
  <% } else { %>
  <form class="form-stack" data-auth-form="reset" data-token="<%= token %>" novalidate>
    <div class="form-error" data-form-error hidden></div>
    <div class="field">
      <label for="reset-password">Password baru</label>
      <input id="reset-password" type="password" name="password" autocomplete="new-password" placeholder="Minimal 8 karakter" minlength="8" required>
    </div>
    <div class="field">
      <label for="reset-confirm">Konfirmasi password</label>
      <input id="reset-confirm" type="password" name="confirmPassword" autocomplete="new-password" placeholder="Ulangi password" minlength="8" required>
    </div>
    <button class="btn btn-primary btn-block" type="submit" data-submit>
      <span data-submit-label>Simpan password baru</span>
      <span class="spinner" data-spinner hidden aria-hidden="true"></span>
    </button>
  </form>
  <% } %>
</div>
