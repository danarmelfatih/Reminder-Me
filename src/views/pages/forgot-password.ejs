<div class="auth-card">
  <p class="eyebrow">Pemulihan akun</p>
  <h2>Lupa password?</h2>
  <p class="auth-lead">Masukkan email akun Anda. Kami akan mengirim tautan untuk mengatur ulang password.</p>

  <form class="form-stack" data-auth-form="forgot" novalidate>
    <div class="form-error" data-form-error hidden></div>
    <div class="form-success" data-form-success hidden></div>
    <div class="field">
      <label for="forgot-email">Email</label>
      <input id="forgot-email" type="email" name="email" autocomplete="email" placeholder="nama@email.com" required>
    </div>
    <button class="btn btn-primary btn-block" type="submit" data-submit>
      <span data-submit-label>Kirim tautan</span>
      <span class="spinner" data-spinner hidden aria-hidden="true"></span>
    </button>
  </form>

  <p class="auth-switch"><a href="/login">Kembali ke halaman masuk</a></p>
</div>
