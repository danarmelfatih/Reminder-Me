<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#1f6b5c">
  <title><%= title %> · Reminder Me</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="public-body <%= bodyClass %>" data-page="<%= pageId || '' %>" data-authed="<%= user ? 'true' : 'false' %>">
  <%- include('../partials/icon-sprite') %>
  <a class="skip-link" href="#main-content">Lewati ke konten</a>
  <header class="public-header">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none"><path d="M8 5.5h16v22l-8-5.2-8 5.2v-22Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M12 12h8M12 16.5h5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </span>
      <span class="brand-name">Reminder Me</span>
    </a>
    <nav class="public-nav" aria-label="Navigasi utama">
      <% if (user) { %>
        <a class="btn btn-primary btn-sm" href="/app">Buka aplikasi</a>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login">Login</a>
        <a class="btn btn-primary btn-sm" href="/register">Register</a>
      <% } %>
    </nav>
  </header>
  <main id="main-content">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <footer class="public-footer">
    <span>Reminder Me — ruang pribadi untuk informasi penting.</span>
    <span class="footer-sep" aria-hidden="true">·</span>
    <span>Data Anda tidak dibagikan.</span>
  </footer>
  <div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>
  <div id="modal-root"></div>
  <script type="module" src="/js/app.js"></script>
  <% if (pageScript) { %>
  <script type="module" src="<%= pageScript %>"></script>
  <% } %>
</body>
</html>
