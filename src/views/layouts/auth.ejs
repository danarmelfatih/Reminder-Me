<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#1f6b5c">
  <title><%= title %> · Reminder Me</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <script>
    (function(){
      const key='reminder_theme';
      const stored=localStorage.getItem(key);
      const dark=stored==='dark'||(!stored&&window.matchMedia('(prefers-color-scheme: dark)').matches);
      if(dark)document.documentElement.dataset.theme='dark';
    })();
  </script>
  <script type="module" src="/js/theme.js"></script>
</head>
<body class="auth-body" data-page="<%= pageId || '' %>" data-authed="false" data-next="<%= typeof next !== 'undefined' ? next : '/app' %>">
  <%- include('../partials/icon-sprite') %>
  <a class="skip-link" href="#auth-content">Lewati ke formulir</a>
  <div class="auth-shell">
    <aside class="auth-aside">
      <a class="brand brand-inverse" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="M8 5.5h16v22l-8-5.2-8 5.2v-22Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M12 12h8M12 16.5h5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </span>
        <span class="brand-name">Reminder Me</span>
      </a>
      <div class="auth-aside-copy">
        <p class="eyebrow eyebrow-inverse">Ruang informasi pribadi</p>
        <h1>Simpan yang penting.<br>Ingat saat dibutuhkan.</h1>
        <p class="auth-aside-lead">Link, catatan, foto, dan dokumen dalam satu tempat. Pengingat hanya jika Anda membutuhkannya.</p>
        <ul class="auth-points">
          <li><span class="auth-point-icon"><svg class="icon"><use href="#icon-shield"></use></svg></span>Pribadi dan terisolasi per akun</li>
          <li><span class="auth-point-icon"><svg class="icon"><use href="#icon-bell"></use></svg></span>Pengingat in-app dan email</li>
          <li><span class="auth-point-icon"><svg class="icon"><use href="#icon-search"></use></svg></span>Pencarian judul, catatan, dan isi dokumen</li>
        </ul>
      </div>
      <p class="auth-aside-foot">Dibuat untuk informasi yang tidak boleh terlupakan.</p>
    </aside>
    <main class="auth-main" id="auth-content">
      <div class="auth-main-inner">
        <a class="auth-back" href="/">
          <svg class="icon"><use href="#icon-chevron-left"></use></svg>
          Kembali ke beranda
        </a>
        <%- include('../partials/flash') %>
        <%- body %>
      </div>
    </main>
  </div>
  <div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>
  <div id="modal-root"></div>
  <script type="module" src="/js/app.js"></script>
  <% if (pageScript) { %>
  <script type="module" src="<%= pageScript %>"></script>
  <% } %>
</body>
</html>
