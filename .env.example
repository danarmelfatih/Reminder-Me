NODE_ENV=development
PORT=3004
APP_URL=http://localhost:3004
DATABASE_URL=postgres://postgres@localhost:5432/reminder_me
COOKIE_SECURE=false
TRUST_PROXY=0

STORAGE_DIR=./storage
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
DEFAULT_FOLDER_LIMIT=50
DEFAULT_TAG_LIMIT=100
STORAGE_WARN_PERCENT=80
STORAGE_CRITICAL_PERCENT=95

MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Reminder Me <onboarding@resend.dev>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3004/api/auth/google/callback

WORKER_POLL_MS=15000
EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_RETENTION_DAYS=90
